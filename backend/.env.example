# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (matches docker-compose.yml) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_social_feed?schema=public

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use long random strings in production (min 32 chars enforced at boot).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── CORS (comma-separated origins, * for local dev) ──────────────────────────
CORS_ORIGINS=*

# ── Proxies ──────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the API (0 = exposed directly).
# Only raise this to the number of proxies you actually run: trusting
# X-Forwarded-For when nothing rewrites it lets clients forge their own IP
# and slip past the per-IP rate limiter.
TRUST_PROXY=0

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Firebase Cloud Messaging (optional) ──────────────────────────────────────
# If any of these are empty, push notifications are disabled gracefully
# (the API logs and no-ops instead of crashing).
# Values come from the Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the private key on one line with \n escapes, exactly as in the JSON file.
FIREBASE_PRIVATE_KEY=
